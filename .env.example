# LLM runtime
ORCHESTRATOR_PLANNER_MODEL=llama3.1:8b
ORCHESTRATOR_CODER_MODEL=deepseek-coder:6.7b
ORCHESTRATOR_REVIEWER_MODEL=llama3.1:8b
ORCHESTRATOR_BENCHMARK_TIMEOUT_SECONDS=8

# Ollama / fallback behavior
OLLAMA_BASE_URL=http://127.0.0.1:11434
ORCHESTRATOR_MOCK_LLM=0
ORCHESTRATOR_FALLBACK_TO_MOCK=1
ORCHESTRATOR_FALLBACK_WARN=1

# MCP bridge
MCP_REQUEST_TIMEOUT_SECONDS=20
NODE_BIN=node
